# frontend/.env.example — copy to .env and fill in real values. See docs/SETUP.md §3.
# NEVER commit .env. This file IS meant to be committed.

# PostgreSQL connection string (local or cloud dev instance e.g. Neon/Supabase/Render)
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/pragati_furniture

# Admin JWT — sign a long random secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_SECONDS=3600

# Cloudinary (free tier) — for product image uploads from the admin panel
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Notification service — see ../notification-service/.env.example
NOTIFICATION_SERVICE_URL=http://localhost:4000
INTERNAL_API_KEY=replace-with-a-shared-secret

# SEO / canonical URLs — set to the real domain in production
SITE_URL=http://localhost:3000

# Seed script (optional overrides)
SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=change-before-first-login
SEED_WITH_SAMPLE_PRODUCTS=true